# === Telegram Bot Tokens ===
# Dùng cho tanbaycu-documents & tanbaycu-vision
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Dùng cho tanbaycu-assistants (tự fallback về TELEGRAM_TOKEN nếu bỏ trống)
BOT_TOKEN_NE=

# === Google Gemini API ===
GEMINI_API_KEY=your_gemini_api_key_here
# Tên model Gemini mặc định (tùy chọn, mặc định: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Dùng cho tanbaycu-assistants (tự fallback về GEMINI_API_KEY nếu bỏ trống)
GEMINI_KEY=
GEMINI_KEY_BACKUP=

# === Tùy chọn Google Drive cho tanbaycu-vision (video > 20MB) ===
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=
